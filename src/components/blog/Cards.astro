---
import InlineText from "@/components/blog/InlineText.astro";
import {
  LuAppWindow,
  LuBadgeCheck,
  LuBadgeX,
  LuBan,
  LuBell,
  LuCable,
  LuCircleDot,
  LuClock,
  LuCpu,
  LuDatabase,
  LuDownload,
  LuFactory,
  LuFileWarning,
  LuGamepad2,
  LuGlobe,
  LuHand,
  LuImage,
  LuLandmark,
  LuLaptop,
  LuLock,
  LuLockOpen,
  LuMapPin,
  LuMessageCircle,
  LuPackage,
  LuPlay,
  LuPower,
  LuRefreshCw,
  LuRotateCw,
  LuScanSearch,
  LuShieldCheck,
  LuSignal,
  LuSignalZero,
  LuSmartphone,
  LuSmartphoneNfc,
  LuTrash2,
  LuTriangleAlert,
  LuUsb,
  LuWifi,
} from "react-icons/lu";

// Keys the posts use in MDX; an unknown key falls back to a dot instead of breaking the build
const ICONS = {
  app: LuAppWindow,
  bank: LuLandmark,
  ban: LuBan,
  bell: LuBell,
  broken: LuFileWarning,
  cable: LuCable,
  certified: LuBadgeCheck,
  chip: LuCpu,
  clock: LuClock,
  data: LuDatabase,
  factory: LuFactory,
  game: LuGamepad2,
  globe: LuGlobe,
  hand: LuHand,
  key: LuCircleDot,
  laptop: LuLaptop,
  lock: LuLock,
  message: LuMessageCircle,
  nfc: LuSmartphoneNfc,
  nosignal: LuSignalZero,
  package: LuPackage,
  phone: LuSmartphone,
  photo: LuImage,
  power: LuPower,
  reboot: LuRotateCw,
  refresh: LuRefreshCw,
  region: LuMapPin,
  search: LuScanSearch,
  shield: LuShieldCheck,
  signal: LuSignal,
  uncertified: LuBadgeX,
  unlock: LuLockOpen,
  update: LuDownload,
  usb: LuUsb,
  video: LuPlay,
  warning: LuTriangleAlert,
  wifi: LuWifi,
  wipe: LuTrash2,
};

const TONES = {
  sky: "tile-sky",
  indigo: "tile-indigo",
  violet: "tile-violet",
  emerald: "tile-emerald",
  gold: "tile-gold",
  rose: "tile-rose",
  slate: "tile-slate",
};

interface Item {
  icon: string;
  title: string;
  text: string;
  tone?: keyof typeof TONES;
}

interface Props {
  items: Item[];
  /** One column for long texts, two (default) for short ones */
  columns?: 1 | 2;
}

const { items, columns = 2 } = Astro.props;
---

<ul class:list={["not-prose my-10 grid gap-4", columns === 2 && "sm:grid-cols-2"]}>
  {items.map(({ icon, title, text, tone = "indigo" }) => {
    const Icon = ICONS[icon as keyof typeof ICONS] ?? LuCircleDot;
    return (
      <li class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-dark-700 dark:bg-dark-800">
        <p class="flex items-center gap-3">
          <span class:list={["tile tile-sm", TONES[tone]]} aria-hidden="true">
            <Icon size={16} />
          </span>
          <span class="text-heading leading-snug font-bold">{title}</span>
        </p>
        <p class="text-body mt-3 leading-relaxed">
          <InlineText text={text} />
        </p>
      </li>
    );
  })}
</ul>
