---
import InlineText from "@/components/blog/InlineText.astro";
import { SUMMARY_ROWS, SUMMARY_TITLE } from "@/components/blog/summary-data";
import { LuCheck, LuInfo, LuX } from "react-icons/lu";

interface Props {
  /** What the screen or error means */
  what: string;
  /** The step that loses data or makes things worse */
  avoid: string;
  /** The one zero-risk thing to try */
  safe: string;
}

const STYLES = {
  what: { tone: "tile-sky", Icon: LuInfo },
  avoid: { tone: "tile-rose", Icon: LuX },
  safe: { tone: "tile-emerald", Icon: LuCheck },
};

const ROWS = SUMMARY_ROWS.map(({ prop, label }) => ({
  label,
  text: Astro.props[prop],
  ...STYLES[prop],
}));
---

<aside
  aria-label={SUMMARY_TITLE}
  class="not-prose my-10 rounded-2xl border border-gray-200 bg-slate-50 p-5 sm:p-6 dark:border-dark-700 dark:bg-dark-900/60"
>
  <p class="text-muted text-xs font-semibold tracking-[0.14em] uppercase">{SUMMARY_TITLE}</p>
  <dl class="mt-4 space-y-4">
    {/* A dl row may hold only dt and dd, so the icon sits inside the dt */}
    {ROWS.map(({ label, text, tone, Icon }) => (
      <div class="relative min-h-9 pl-[2.875rem]">
        <dt class="text-heading text-sm font-bold">
          <span class:list={["tile tile-sm absolute top-0.5 left-0", tone]} aria-hidden="true">
            <Icon size={16} />
          </span>
          {label}
        </dt>
        <dd class="text-body mt-0.5 leading-relaxed">
          <InlineText text={text} />
        </dd>
      </div>
    ))}
  </dl>
</aside>
