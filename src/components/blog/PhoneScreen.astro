---
import InlineText from "@/components/blog/InlineText.astro";
import { LuCheck, LuInfo, LuX } from "react-icons/lu";

type Screen =
  "main-menu" | "nv-data" | "fastboot" | "play-protect" | "version" | "ad" | "alert" | "integrity";
type Level = "basic" | "device" | "strong";
type Tone = "safe" | "danger" | "warn" | "info" | "key";
type Note = { tone: Tone; text: string };

interface Props {
  screen: Screen;
  /** Pulsing ring on a side key, for "press this" steps */
  pulse?: "power" | "volume";
  /** play-protect: draw the certified state instead of the uncertified one */
  certified?: boolean;
  /** version: the region letters in the HyperOS version string */
  region?: string;
  /** alert: dialog title and message, as the app shows them */
  title?: string;
  message?: string;
  /** integrity: the Play Integrity levels that pass, the rest are drawn as failing */
  pass?: Level[];
  /** Replaces the notes next to the drawing */
  notes?: Note[];
}

const {
  screen,
  pulse = screen === "fastboot" ? "power" : undefined,
  certified = false,
  region = "CN",
  title = "Uyarı",
  message = "",
  pass = [],
  notes,
} = Astro.props;

// A drawing of the screen, not a screenshot: the maker's mascots and logos stay out
const LABELS: Record<Screen, string> = {
  "main-menu":
    "Xiaomi kurtarma ekranı çizimi: Main Menu başlığı altında Reboot, Wipe Data, Connect with MIAssistant ve Safe Mode satırları. Reboot güvenli, Wipe Data tehlikeli diye işaretli.",
  "nv-data":
    "Xiaomi kurtarma ekranı çizimi: Main Menu satırlarının altında kırmızı 'NV data is corrupted' yazısı.",
  fastboot:
    "Xiaomi Fastboot ekranı çizimi: siyah ekranda turuncu FASTBOOT yazısı, telefonun sağındaki güç tuşu işaretli.",
  "play-protect": `Play Store Hakkında ekranı çizimi: Play Protect sertifikası satırında '${certified ? "Cihaz sertifikalı" : "Cihaz sertifikalı değil"}' yazıyor.`,
  version: `Telefon hakkında ekranı çizimi: HyperOS sürüm kodunun sonundaki bölge harfleri ${region} olarak işaretli.`,
  ad: "Telefon ekranını kaplayan reklam çizimi: büyük bir 'Temizle' düğmesi ve köşede küçücük bir kapatma işareti.",
  alert: `Uygulama uyarısı çizimi: ${title}. ${message}`,
  integrity: `Play Integrity kontrol ekranı çizimi: ${pass.length ? `geçen düzeyler ${pass.join(", ")}` : "basic, device ve strong düzeylerinin üçü de geçmiyor"}.`,
};

const DEFAULT_NOTES: Record<Screen, Note[]> = {
  "main-menu": [
    { tone: "safe", text: "Reboot: telefonu yeniden başlatır, veri silmez." },
    { tone: "danger", text: "Wipe Data: telefondaki her şeyi kalıcı olarak siler." },
  ],
  "nv-data": [
    { tone: "safe", text: "Reboot: veri silmez, denemesi güvenli." },
    { tone: "danger", text: "Wipe Data: bu hatayı düzeltmez, verileri siler." },
  ],
  fastboot: [{ tone: "key", text: "Güç tuşu: telefon yeniden açılana kadar basılı tutun." }],
  "play-protect": [
    { tone: "info", text: "Yol: Play Store, profil simgesi, Ayarlar, Hakkında." },
    certified
      ? { tone: "safe", text: "Cihaz sertifikalı: Google bu telefonu tanıyor." }
      : {
          tone: "danger",
          text: "Cihaz sertifikalı değil: Google bu telefonu kendi listesinde görmüyor.",
        },
  ],
  version: [
    region === "CN"
      ? { tone: "warn", text: "CN: telefonda Çin sürümü yazılım var." }
      : { tone: "safe", text: `${region}: telefonda global sürüm yazılım var.` },
    { tone: "info", text: "MI global, EU Avrupa, TR Türkiye, CN Çin sürümü demek." },
  ],
  ad: [
    {
      tone: "danger",
      text: "Tam ekran ve kapatma işareti küçücük: çoğu zaman yüklü bir uygulamadan gelir.",
    },
    { tone: "warn", text: '"Temizle" gibi büyük düğmelere dokunmayın.' },
  ],
  alert: [],
  integrity: [
    pass.length === 3
      ? { tone: "safe", text: "Üç düzey de geçiyor: uygulamalar telefona güveniyor." }
      : {
          tone: "danger",
          text: "Geçmeyen düzeyler kırmızı: o düzeyi isteyen uygulamalar açılmaz ya da uyarı verir.",
        },
    { tone: "info", text: "Basic en gevşek, strong en sıkı kontrol." },
  ],
};

const shownNotes = notes ?? DEFAULT_NOTES[screen];

const MENU = ["Reboot", "Wipe Data", "Connect with MIAssistant", "Safe Mode"];
const showMenu = screen === "main-menu" || screen === "nv-data";
const lightScreen = !showMenu && screen !== "fastboot" && screen !== "integrity";

const LEVELS: Level[] = ["basic", "device", "strong"];

const KEY_Y = { volume: 153, power: 226 };

// SVG text does not wrap, so the alert message is broken into lines here
function wrap(text: string, width: number) {
  const lines: string[] = [];
  let line = "";
  for (const word of text.split(/\s+/).filter(Boolean)) {
    if (line && (line + " " + word).length > width) {
      lines.push(line);
      line = word;
    } else {
      line = line ? `${line} ${word}` : word;
    }
  }
  if (line) lines.push(line);
  return lines.slice(0, 5);
}
const messageLines = wrap(message, 26);

// Version string drawn in a monospaced face so the region letters can be boxed
const VERSION_PREFIX = "OS2.0.200.0.VNC";
const CHAR = 6.9;
const versionStart = 142 - ((VERSION_PREFIX.length + region.length + 2) * CHAR) / 2;
const regionX = versionStart + VERSION_PREFIX.length * CHAR;
const regionColor = region === "CN" ? "#d97706" : "#059669";
---

<figure class="not-prose my-10 rounded-2xl border border-gray-200 bg-slate-50 p-5 sm:p-6 md:grid md:grid-cols-[13rem_1fr] md:content-center md:gap-x-8 dark:border-dark-700 dark:bg-dark-900/60">
  <svg
    viewBox="0 0 300 560"
    role="img"
    aria-label={LABELS[screen]}
    class="mx-auto block h-auto w-full max-w-52 md:row-span-2 md:self-center"
  >
    <rect
      x="24"
      y="16"
      width="236"
      height="528"
      rx="38"
      class="fill-white stroke-gray-300 dark:fill-dark-800 dark:stroke-dark-600"
      stroke-width="2"
    ></rect>
    <rect
      x="259"
      y="118"
      width="5"
      height="70"
      rx="2"
      class="fill-gray-300 dark:fill-dark-600"
    ></rect>
    <rect
      x="259"
      y="206"
      width="5"
      height="40"
      rx="2"
      class="fill-gray-300 dark:fill-dark-600"
    ></rect>
    <rect
      x="36"
      y="28"
      width="212"
      height="504"
      rx="28"
      fill={lightScreen ? "#f8f9fa" : "#050507"}
      stroke={lightScreen ? "#e3e5e8" : "none"}
    ></rect>

    {showMenu && (
      <g transform="translate(0 45)">
        <text x="142" y="122" text-anchor="middle" font-size="22" font-weight="500" fill="#c7c9ea">
          Main Menu
        </text>
        {MENU.map((item, index) => {
          const y = 196 + index * 46;
          const selected = index === 0;
          const danger = item === "Wipe Data";
          return (
            <g>
              <rect
                x="60"
                y={y}
                width="164"
                height="36"
                rx="4"
                fill={selected ? "#1d8cf8" : "none"}
                stroke={danger ? "#f43f5e" : selected ? "none" : "#3a3d46"}
                stroke-width={danger ? 2 : 1}
              />
              <text
                x="142"
                y={y + 23}
                text-anchor="middle"
                font-size={item.length > 12 ? 11 : 13}
                fill={selected ? "#ffffff" : "#e6e7f2"}
              >
                {item}
              </text>
            </g>
          );
        })}
        <circle cx="224" cy="214" r="12" fill="#10b981" />
        <path
          d="M218.5 214.5l3.5 3.5 7-7.5"
          fill="none"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="224" cy="260" r="12" fill="#f43f5e" />
        <path
          d="M219.5 255.5l9 9m0-9l-9 9"
          fill="none"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </g>
    )}

    {screen === "nv-data" && (
      <text x="142" y="472" text-anchor="middle" font-size="13" font-weight="600" fill="#ff5a5f">
        NV data is corrupted
      </text>
    )}

    {screen === "fastboot" && (
      <text
        x="142"
        y="300"
        text-anchor="middle"
        font-size="26"
        font-weight="700"
        letter-spacing="1"
        fill="#ff6a13"
      >
        FASTBOOT
      </text>
    )}

    {screen === "play-protect" && (
      <g>
        <text x="56" y="92" font-size="13" fill="#5f6368">
          ←
        </text>
        <text x="76" y="92" font-size="17" font-weight="600" fill="#1f1f1f">
          Hakkında
        </text>
        <text x="56" y="146" font-size="12.5" fill="#1f1f1f">
          Play Store sürümü
        </text>
        <rect x="56" y="156" width="96" height="7" rx="3.5" fill="#dadce0" />
        <rect
          x="46"
          y="190"
          width="192"
          height="62"
          rx="12"
          fill={certified ? "#e6f4ea" : "#fce8e6"}
          stroke={certified ? "#34a853" : "#ea4335"}
          stroke-width="1.5"
        />
        <text x="56" y="214" font-size="12.5" font-weight="600" fill="#1f1f1f">
          Play Protect sertifikası
        </text>
        <text
          x="56"
          y="236"
          font-size="12"
          font-weight="600"
          fill={certified ? "#188038" : "#d93025"}
        >
          {certified ? "Cihaz sertifikalı" : "Cihaz sertifikalı değil"}
        </text>
        <text x="56" y="292" font-size="12.5" fill="#1f1f1f">
          Lisanslar
        </text>
        <rect x="56" y="302" width="120" height="7" rx="3.5" fill="#dadce0" />
        <text x="56" y="346" font-size="12.5" fill="#1f1f1f">
          Hizmet Şartları
        </text>
        <rect x="56" y="356" width="80" height="7" rx="3.5" fill="#dadce0" />
      </g>
    )}

    {screen === "version" && (
      <g>
        <text x="56" y="92" font-size="13" fill="#5f6368">
          ←
        </text>
        <text x="76" y="92" font-size="16" font-weight="600" fill="#1f1f1f">
          Telefon hakkında
        </text>
        <rect x="50" y="118" width="184" height="118" rx="16" fill="#ffffff" stroke="#e3e5e8" />
        <text x="142" y="156" text-anchor="middle" font-size="16" font-weight="700" fill="#1f1f1f">
          HyperOS
        </text>
        <rect
          x={regionX - 2}
          y="174"
          width={region.length * CHAR + 4}
          height="20"
          rx="4"
          fill={regionColor}
          fill-opacity="0.16"
          stroke={regionColor}
        />
        <text
          x={versionStart}
          y="188"
          font-size="11.5"
          font-family="ui-monospace, monospace"
          fill="#3c4043"
        >
          {VERSION_PREFIX}
          <tspan font-weight="700" fill={regionColor}>
            {region}
          </tspan>
          XM
        </text>
        <text x="142" y="218" text-anchor="middle" font-size="10.5" fill="#5f6368">
          Sistem sürümü
        </text>
        <text x="56" y="282" font-size="12.5" fill="#1f1f1f">
          Model
        </text>
        <rect x="56" y="292" width="110" height="7" rx="3.5" fill="#dadce0" />
        <text x="56" y="336" font-size="12.5" fill="#1f1f1f">
          Android sürümü
        </text>
        <rect x="56" y="346" width="60" height="7" rx="3.5" fill="#dadce0" />
        <text x="56" y="390" font-size="12.5" fill="#1f1f1f">
          Tüm özellikler
        </text>
        <rect x="56" y="400" width="90" height="7" rx="3.5" fill="#dadce0" />
      </g>
    )}

    {(screen === "ad" || screen === "alert") && (
      <g>
        <rect x="36" y="28" width="212" height="56" rx="28" fill="#e8eaed" />
        <rect x="36" y="56" width="212" height="28" fill="#e8eaed" />
        {[110, 170, 230, 290, 350, 410].map((y) => (
          <g>
            <rect x="56" y={y} width="36" height="36" rx="8" fill="#e3e5e8" />
            <rect x="102" y={y + 6} width="120" height="8" rx="4" fill="#e3e5e8" />
            <rect x="102" y={y + 22} width="80" height="8" rx="4" fill="#eceef0" />
          </g>
        ))}
        <rect x="36" y="28" width="212" height="504" rx="28" fill="#000" fill-opacity="0.55" />
      </g>
    )}

    {screen === "ad" && (
      <g>
        <rect x="54" y="132" width="176" height="300" rx="18" fill="#ffffff" />
        <rect x="66" y="146" width="152" height="130" rx="12" fill="#fde68a" />
        <text x="142" y="218" text-anchor="middle" font-size="22" font-weight="800" fill="#b45309">
          REKLAM
        </text>
        <circle cx="220" cy="140" r="6" fill="#d1d5db" />
        <path d="M217.8 137.8l4.4 4.4m0-4.4l-4.4 4.4" stroke="#6b7280" stroke-width="1.3" />
        <circle cx="220" cy="140" r="11" fill="none" stroke="#f43f5e" stroke-width="2" />
        <text x="142" y="312" text-anchor="middle" font-size="14" font-weight="700" fill="#111827">
          Telefonunuz yavaşladı
        </text>
        <text x="142" y="334" text-anchor="middle" font-size="11" fill="#6b7280">
          Hemen temizleyin
        </text>
        <rect x="76" y="360" width="132" height="44" rx="22" fill="#ef4444" />
        <text x="142" y="388" text-anchor="middle" font-size="15" font-weight="800" fill="#ffffff">
          TEMİZLE
        </text>
      </g>
    )}

    {screen === "alert" && (
      <g>
        <rect
          x="52"
          y="196"
          width="180"
          height={124 + messageLines.length * 16}
          rx="18"
          fill="#ffffff"
        />
        <circle cx="142" cy="226" r="14" fill="#fde8ea" />
        <text x="142" y="231" text-anchor="middle" font-size="16" font-weight="800" fill="#e11d48">
          !
        </text>
        <text
          x="142"
          y="264"
          text-anchor="middle"
          font-size="13.5"
          font-weight="700"
          fill="#111827"
        >
          {title}
        </text>
        <text x="142" y="286" text-anchor="middle" font-size="11.5" fill="#4b5563">
          {messageLines.map((line, index) => (
            <tspan x="142" dy={index === 0 ? 0 : 16}>
              {line}
            </tspan>
          ))}
        </text>
        <text
          x="212"
          y={300 + messageLines.length * 16}
          text-anchor="end"
          font-size="12.5"
          font-weight="700"
          fill="#1d4ed8"
        >
          Tamam
        </text>
      </g>
    )}

    {screen === "integrity" && (
      <g>
        <text x="56" y="92" font-size="14" font-weight="600" fill="#e6e7f2">
          Play Integrity
        </text>
        <line x1="36" y1="112" x2="248" y2="112" stroke="#2a2d34" />
        {LEVELS.map((level, index) => {
          const y = 200 + index * 62;
          const ok = pass.includes(level);
          return (
            <g>
              <circle cx="68" cy={y} r="15" fill={ok ? "#10b981" : "#dc2626"} />
              <path
                d={ok ? `M61 ${y}l5 5 9-10` : `M62 ${y - 6}l12 12m0-12l-12 12`}
                fill="none"
                stroke="#ffffff"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <text x="92" y={y + 4} font-size="10.5" font-weight="500" fill="#e6e7f2">
                {`MEETS_${level.toUpperCase()}_INTEGRITY`}
              </text>
            </g>
          );
        })}
        <rect x="102" y="400" width="80" height="30" rx="5" fill="none" stroke="#4b4f58" />
        <text x="142" y="420" text-anchor="middle" font-size="11" letter-spacing="1" fill="#e6e7f2">
          CHECK
        </text>
      </g>
    )}

    {pulse && (
      <g class="text-gold-400">
        <circle
          cx="262"
          cy={KEY_Y[pulse]}
          r="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="origin-center [transform-box:fill-box] motion-safe:animate-ping"
        />
        <circle
          cx="262"
          cy={KEY_Y[pulse]}
          r="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        />
      </g>
    )}
  </svg>

  {shownNotes.length > 0 && (
    <ul
      class:list={[
        "mt-5 space-y-2.5 md:mt-0",
        Astro.slots.has("default") ? "md:self-end" : "md:row-span-2 md:self-center",
      ]}
    >
      {shownNotes.map(({ tone, text }) => (
        <li class="flex gap-2.5 text-[0.9375rem] leading-relaxed">
          <span
            aria-hidden="true"
            class:list={[
              "mt-1 flex size-5 flex-none items-center justify-center rounded-full text-white",
              tone === "safe" && "bg-emerald-500",
              tone === "danger" && "bg-rose-500",
              tone === "warn" && "bg-amber-500",
              tone === "info" && "bg-sky-500",
              tone === "key" && "bg-gold-400",
            ]}
          >
            {tone === "danger" ? (
              <LuX size={12} />
            ) : tone === "info" || tone === "warn" ? (
              <LuInfo size={12} />
            ) : (
              <LuCheck size={12} />
            )}
          </span>
          <span class="text-body">
            <InlineText text={text} />
          </span>
        </li>
      ))}
    </ul>
  )}
  {Astro.slots.has("default") && (
    <figcaption class="text-muted mt-4 self-start border-t border-gray-200 pt-4 text-sm leading-relaxed dark:border-dark-700 [&_code]:text-xs [&_p]:m-0">
      <slot />
    </figcaption>
  )}
</figure>
