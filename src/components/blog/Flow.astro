---
import InlineText from "@/components/blog/InlineText.astro";
import { LuCheck, LuTriangleAlert } from "react-icons/lu";

interface Branch {
  /** The answer, e.g. "Evet" */
  label: string;
  /** What that answer means and what to do */
  text: string;
  tone?: "safe" | "warn";
}

interface Props {
  question: string;
  branches: Branch[];
}

const { question, branches } = Astro.props;
---

<div class="not-prose my-10" role="group" aria-label={question}>
  <p class="text-heading mx-auto max-w-md rounded-2xl border border-gray-200 bg-white px-5 py-4 text-center font-bold shadow-sm dark:border-dark-700 dark:bg-dark-800">
    {question}
  </p>

  <!-- Connector: one stem down from the question, then a bar across the answers from sm -->
  <div aria-hidden="true" class="relative h-8">
    <span class="absolute top-0 left-1/2 h-full w-px bg-gray-300 dark:bg-dark-600"></span>
    <span class="absolute right-1/4 bottom-0 left-1/4 hidden h-px bg-gray-300 sm:block dark:bg-dark-600"></span>
  </div>

  <ul class:list={["grid gap-4", branches.length > 1 && "sm:grid-cols-2"]}>
    {branches.map(({ label, text, tone = "safe" }) => (
      <li class="relative rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:mt-4 dark:border-dark-700 dark:bg-dark-800">
        <span
          aria-hidden="true"
          class="absolute -top-4 left-1/2 hidden h-4 w-px bg-gray-300 sm:block dark:bg-dark-600"
        />
        <p class="flex items-center gap-2 font-bold">
          <span
            aria-hidden="true"
            class:list={["tile tile-sm", tone === "safe" ? "tile-emerald" : "tile-rose"]}
          >
            {tone === "safe" ? <LuCheck size={15} /> : <LuTriangleAlert size={15} />}
          </span>
          <span class="text-heading">{label}</span>
        </p>
        <p class="text-body mt-3 leading-relaxed">
          <InlineText text={text} />
        </p>
      </li>
    ))}
  </ul>
</div>
